# Copy to .env and adjust. Used by docker-compose.yml (passed via env_file),
# so the variable names here match exactly what the binary reads.

# ── Port the whole stack is published on (Traefik entrypoint) ────────────────
LISTEN_PORT=8080
TZ=Europe/Berlin

# ── OpenCloud backend (opencloud-immichframe) ───────────────────────────────
# If OpenCloud runs on the Docker host, use host.docker.internal (mapped in the
# compose file). If it runs in another compose/stack, use its service URL.
# OC_URL is the shared OpenCloud variable; OPENCLOUD_IMMICHFRAME_URL also works.
OC_URL=https://host.docker.internal:9200

# Provide either the space id or the space name.
# NOTE: values in this file are passed verbatim via docker-compose `env_file`,
# so a literal `$` in a space id does NOT need to be doubled here.
# Using the space NAME instead avoids the whole issue.
OPENCLOUD_IMMICHFRAME_SPACE_ID=
OPENCLOUD_IMMICHFRAME_SPACE_NAME=Images

# App-token auth (username + app password). See README for PROXY_ENABLE_APP_AUTH.
OPENCLOUD_IMMICHFRAME_USERNAME=dennis
OPENCLOUD_IMMICHFRAME_APP_PASSWORD=change-me
# Or, instead of username/app-password, a bearer token:
# OPENCLOUD_IMMICHFRAME_BEARER_TOKEN=

# Accept the self-signed cert of a dev OpenCloud instance.
# OC_INSECURE is the shared OpenCloud variable; OPENCLOUD_IMMICHFRAME_INSECURE also works.
OC_INSECURE=true

# Shared secret the web UI must send as `Authorization: Bearer <secret>`.
# Leave empty (or omit) to run the API open (simplest for a first test).
OPENCLOUD_IMMICHFRAME_AUTH_SECRET=

# ── Slideshow / web-UI display settings (surfaced via /api/Config) ──────────
# All optional; the defaults shown here are the built-in defaults. Uncomment to
# override. Commented lines are NOT passed to the container, so the built-in
# defaults apply.
# OPENCLOUD_IMMICHFRAME_INTERVAL=8                       # seconds each image is shown
# OPENCLOUD_IMMICHFRAME_TRANSITION_DURATION=1            # crossfade seconds
# OPENCLOUD_IMMICHFRAME_SHOW_CLOCK=true
# OPENCLOUD_IMMICHFRAME_CLOCK_FORMAT=HH:mm               # date-fns time tokens
# OPENCLOUD_IMMICHFRAME_CLOCK_DATE_FORMAT=eee, MMM d     # date-fns date tokens
# OPENCLOUD_IMMICHFRAME_SHOW_PROGRESS_BAR=true
# OPENCLOUD_IMMICHFRAME_SHOW_PHOTO_DATE=true
# OPENCLOUD_IMMICHFRAME_PHOTO_DATE_FORMAT=2006-01-02     # Go layout (formatted server-side)
# OPENCLOUD_IMMICHFRAME_SHOW_IMAGE_LOCATION=false        # no EXIF/GPS in OpenCloud yet
# OPENCLOUD_IMMICHFRAME_IMAGE_LOCATION_FORMAT=City,State,Country
# OPENCLOUD_IMMICHFRAME_SHOW_IMAGE_DESC=false
# OPENCLOUD_IMMICHFRAME_SHOW_ALBUM_NAME=true             # album = the image's folder
# OPENCLOUD_IMMICHFRAME_LANGUAGE=en
