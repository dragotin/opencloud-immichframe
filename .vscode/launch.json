    "version": "0.2.0",
    "configurations": [

        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "cmd/opencloud-immichframe",
            "env": {
                "OC_URL": "https://localhost:9200/",
                "OPENCLOUD_IMMICHFRAME_SPACE_ID": "<space-id>",
                "OPENCLOUD_IMMICHFRAME_USERNAME": "dennis",
                "OPENCLOUD_IMMICHFRAME_APP_PASSWORD": "<app password>",
                "OC_INSECURE": "true",
                "OPENCLOUD_IMMICHFRAME_WEB_ROOT": "${workspaceFolder}/../ImmichFrame/immichFrame.Web/build"
            }
        }
    ]
}
